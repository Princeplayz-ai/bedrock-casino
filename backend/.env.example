# Example .env for backend

# Either provide full DATABASE_URL or DB_HOST/DB_USER/DB_PASS/DB_NAME
# DATABASE_URL=postgres://user:pass@localhost:5432/bedrock
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
